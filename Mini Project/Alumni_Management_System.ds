 application "Alumni Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form Alumni
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			unique Alumni_ID
			(
    			type = text
				displayname = "Alumni ID"
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Full_Name
			(
    			type = text
				displayname = "Full Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Gender
			(
				type = radiobuttons
				values = {"Male","Female","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Date_of_Birth
			(
    			type = date
				displayname = "Date of Birth"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have unique Email
			(
    			type = email
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Phone
			(
    			type = phonenumber
	 			row = 1
	 			column = 1   
				width = medium
				isencrypted = true
			)
			LinkedIn_Profile
			(
    			type = url
				displayname = "LinkedIn Profile"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Profile_Photo
			(
    			type = image
				displayname = "Profile Photo"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have unique Register_Number
			(
    			type = text
				displayname = "Register Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Department
			(
				type = picklist	
				values  = Departments.ID
    			displayformat = [Department_Code]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Programme
			(
				type = picklist
				values = {"M.Tech","M.E.","MCA","B.E.","Ph.D","B.Tech","MBA"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Batch_Start_Year
			(
				type = number
				displayname = "Batch Start Year"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Graduation_Year
			(
				type = number
				displayname = "Graduation Year"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			CGPA
			(
				type = decimal
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			Degree_Certificate
			(
    			type = image
				displayname = "Degree Certificate"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Certificate_Text_OCR
			(
    			type = textarea
				displayname = "Certificate Text (OCR)"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Employment_Status
			(
				type = picklist
				displayname = "Employment Status"
				values = {"Employed","Seeking Opportunities","Higher Studies","Entrepreneur","Government Service","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Current_Organisation
			(
    			type = text
				displayname = "Current Organisation"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Designation
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Industry
			(
				type = picklist
				values = {"Education and Research","Product and Software","Banking and Finance","Consulting","Healthcare","Government and PSU","IT Services","Core Engineering","Startup","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Total_Experience_Years
			(
				type = decimal
				displayname = "Total Experience (Years)"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			Higher_Studies_Institution
			(
    			type = text
				displayname = "Higher Studies Institution"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Higher_Studies_Country
			(
				type = picklist
				displayname = "Higher Studies Country"
				values = {"Canada","USA","Singapore","UK","Australia","Germany","India","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Skills
			(
				type = list	
				values = {"Java","Product Management","VLSI","Finance","Research","Machine Learning","Marketing","Data Science","Cloud Computing","Project Management","Entrepreneurship","Embedded Systems","Web Development","Python"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Employment_History
			(
				type = grid
				displayname = "Employment History"
				values  = Alumni.ID
	 			row = 1
	 			column = 1   
				width = medium
			)
			Resume
			(
    			type = upload file
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			Pincode
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			City
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			State
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Country1
			(
				type = picklist
				displayname = "Country"
				values = {"Canada","USA","Singapore","UK","UAE","Australia","Germany","India","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Willing_to_Mentor
			(
    			type = checkbox
				displayname = "Willing to Mentor"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Mentoring_Areas
			(
				type = list	
				displayname = "Mentoring Areas"
				values = {"Career Guidance","Interview Preparation","Higher Studies","Entrepreneurship","Technical Skills","Research"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Max_Mentees
			(
				type = number
				displayname = "Max Mentees"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Membership_Type
			(
				type = picklist
				displayname = "Membership Type"
				values = {"Basic","Lifetime Member"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Share_Contact_With_Alumni
			(
    			type = checkbox
				displayname = "Share Contact With Alumni"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Verification_Status
			(
				type = picklist
				displayname = "Verification Status"
				values = {"Verified","Pending Verification","Rejected"}
				others option = true
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Verified_On
			(
    			type = date
				displayname = "Verified On"
				alloweddays = 0,1,2,3,4,5,6
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Verification_Remarks
			(
    			type = textarea
				displayname = "Verification Remarks"
				height = 100px
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Profile_Completeness
			(
    			type = percentage
				displayname = "Profile Completeness (%)"
				maxchar = 16
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Active_Mentees
			(
				type = number
				displayname = "Active Mentees"
				maxchar = 19
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Total_Donated
			(
				displayname = "Total Donated"
				type = USD
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Last_Profile_Update
			(
    			type = date
				displayname = "Last Profile Update"
				alloweddays = 0,1,2,3,4,5,6
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Stage1","Stage2","Stage3"}
			}
		}
