	reports
	{
		list Event_Registrations_Report
		{
			displayName = "Event_Registrations Report"
			show all rows from Event_Registrations    
			(
				Registration_No as "Registration No"
				Event
				Alumni
				Registration_Date as "Registration Date"
				Number_of_Guests as "Number of Guests"
				Fee_Payable as "Fee Payable"
				(
					display = total,average,min,max	
				)
				Payment_Status as "Payment Status"
				Attendance_Status as "Attendance Status"
				Feedback_Rating as "Feedback Rating"
				Feedback_Comments as "Feedback Comments"
				Feedback_Sentiment as "Feedback Sentiment"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (Attendance_Status == "Attended")
				fields = [Attendance_Status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (Attendance_Status == "Cancelled")
				fields = [Attendance_Status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (Attendance_Status == "No Show")
				fields = [Attendance_Status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting4"
				{
				condition = (Attendance_Status == "Registered")
				fields = [Attendance_Status]
				format = "color:#ffffff;background-color:#3598db;"
				}
			)
		}
		kanban Event_Registrations_by_Attendance_Status
		{
			displayName = "Attendance Status"
			show all rows from Event_Registrations    
			(
				Registration_No as "Registration No"
				Event
				Alumni
				Registration_Date as "Registration Date"
				Number_of_Guests as "Number of Guests"
				Fee_Payable as "Fee Payable"
				(
					display = total,average,min,max	
				)
				Payment_Status as "Payment Status"
				Attendance_Status as "Attendance Status"
				Feedback_Rating as "Feedback Rating"
				Feedback_Comments as "Feedback Comments"
				Feedback_Sentiment as "Feedback Sentiment"
			)
			options
			(
	 			display field = Attendance_Status
	 		)
		}
		list Mentorship_Requests_Report
		{
			displayName = "Mentorship_Requests Report"
			show all rows from Mentorship_Requests    
			(
				Request_No as "Request No"
				Student_Name as "Student Name"
				Student_Register_Number as "Student Register Number"
				Student_Email as "Student Email"
				Student_Department as "Student Department"
				Student_Year as "Student Year"
				Mentor
				Mentorship_Area as "Mentorship Area"
				Preferred_Mode as "Preferred Mode"
				Message as "Message to Mentor"
				Request_Date as "Request Date"
				Request_Status as "Request Status"
				Mentor_Response as "Mentor Response"
				Sessions.Student_Name as "Sessions"
				(
					view = Mentorship_Requests_Report
				)
				Total_Sessions as "Total Sessions"
				Student_Rating as "Student Rating"
				Completion_Notes as "Completion Notes"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (Preferred_Mode == "In-person")
				fields = [Preferred_Mode]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (Preferred_Mode == "Online")
				fields = [Preferred_Mode]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (Preferred_Mode == "Phone")
				fields = [Preferred_Mode]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban Mentorship_Requests_by_Student_Year
		{
			displayName = "Student Year"
			show all rows from Mentorship_Requests    
			(
				Request_No as "Request No"
				Student_Name as "Student Name"
				Student_Register_Number as "Student Register Number"
				Student_Email as "Student Email"
				Student_Department as "Student Department"
				Student_Year as "Student Year"
				Mentor
				Mentorship_Area as "Mentorship Area"
				Preferred_Mode as "Preferred Mode"
				Message as "Message to Mentor"
				Request_Date as "Request Date"
				Request_Status as "Request Status"
				Mentor_Response as "Mentor Response"
				Sessions.Student_Name as "Sessions"
				(
					view = Mentorship_Requests_Report
				)
				Total_Sessions as "Total Sessions"
				Student_Rating as "Student Rating"
				Completion_Notes as "Completion Notes"
			)
			options
			(
	 			display field = Student_Year
	 		)
		}
		list Donations_Report
		{
			displayName = "Donations Report"
			show all rows from Donations    
			(
				Donation_No as "Donation No"
				Alumni
				Campaign
				Amount
				(
					display = total,average,min,max	
				)
				Donation_Date as "Donation Date"
				Payment_Mode as "Payment Mode"
				Transaction_Reference as "Transaction Reference"
				Donation_Status as "Donation Status"
				Need_80G_Receipt as "Need 80G Receipt"
				PAN_Number as "PAN Number"
				Anonymous_Donation as "Anonymous Donation"
				Receipt_Sent as "Receipt Sent"
				Remarks
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (Payment_Mode == "Card")
				fields = [Payment_Mode]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (Payment_Mode == "Cash")
				fields = [Payment_Mode]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (Payment_Mode == "Cheque")
				fields = [Payment_Mode]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting4"
				{
				condition = (Payment_Mode == "Net Banking")
				fields = [Payment_Mode]
				format = "color:#ffffff;background-color:#3598db;"
				}
			)
		}
