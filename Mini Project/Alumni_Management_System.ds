		workflow
		{
		form
		{
			Alumni_Registered_Email as "Alumni_Registered_Email"
			{
				type =  form
				form = Alumni

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											sendmail
										[
											from :zoho.adminuserid
											to :"saranya05venkatesan@gmail.com"
											subject :"New alumni registered"
											message :"A new alumni profile has been submitted in the Alumni Management System."
										]
						)
					}
				}

			}
		}




